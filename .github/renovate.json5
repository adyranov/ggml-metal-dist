{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: ["config:best-practices", "helpers:pinGitHubActionDigests"],
  prConcurrentLimit: 5,
  timezone: "Etc/UTC",
  customManagers: [
    {
      customType: "regex",
      description: "Track ggml upstream releases (semver)",
      managerFilePatterns: ["/^manifest\\.json$/"],
      matchStrings: ['"upstream_url":\\s*"https://github\\.com/ggml-org/ggml\\.git",\\s*"upstream_ref":\\s*"(?<currentValue>[^"]+)"'],
      depNameTemplate: "ggml-org/ggml",
      datasourceTemplate: "github-tags",
      versioningTemplate: "semver",
    },
    {
      customType: "regex",
      description: "Track llama.cpp upstream releases (build numbers)",
      managerFilePatterns: ["/^manifest\\.json$/"],
      matchStrings: [
        '"upstream_url":\\s*"https://github\\.com/ggml-org/llama\\.cpp\\.git",\\s*"upstream_ref":\\s*"(?<currentValue>[^"]+)"',
      ],
      depNameTemplate: "ggml-org/llama.cpp",
      datasourceTemplate: "github-tags",
      versioningTemplate: "regex:^b(?<major>\\d+)$",
    },
    {
      customType: "regex",
      description: "Track whisper.cpp upstream releases (semver)",
      managerFilePatterns: ["/^manifest\\.json$/"],
      matchStrings: [
        '"upstream_url":\\s*"https://github\\.com/ggml-org/whisper\\.cpp\\.git",\\s*"upstream_ref":\\s*"(?<currentValue>[^"]+)"',
      ],
      depNameTemplate: "ggml-org/whisper.cpp",
      datasourceTemplate: "github-tags",
      versioningTemplate: "semver",
    },
    {
      customType: "regex",
      description: "Track stable-diffusion.cpp upstream releases",
      managerFilePatterns: ["/^manifest\\.json$/"],
      matchStrings: [
        '"upstream_url":\\s*"https://github\\.com/leejet/stable-diffusion\\.cpp\\.git",\\s*"upstream_ref":\\s*"(?<currentValue>[^"]+)"',
      ],
      depNameTemplate: "leejet/stable-diffusion.cpp",
      datasourceTemplate: "github-tags",
      versioningTemplate: "regex:^master-(?<major>\\d+)-(?<build>[a-f0-9]+)$",
    },
    {
      customType: "regex",
      description: "Track parakeet.cpp upstream releases (semver)",
      managerFilePatterns: ["/^manifest\\.json$/"],
      matchStrings: [
        '"upstream_url":\\s*"https://github\\.com/mudler/parakeet\\.cpp\\.git",\\s*"upstream_ref":\\s*"(?<currentValue>[^"]+)"',
      ],
      depNameTemplate: "mudler/parakeet.cpp",
      datasourceTemplate: "github-tags",
      versioningTemplate: "semver",
    },
  ],
  packageRules: [
    {
      description: "Bulk GitHub Actions updates — one PR per month, not per action",
      matchManagers: ["github-actions"],
      groupName: "github-actions",
      groupSlug: "github-actions",
      schedule: ["before 6am on the first day of the month"],
      commitMessageTopic: "GitHub Actions",
      commitMessageExtra: "({{groupName}})",
    },
    {
      description: "Bulk pre-commit hook updates — one PR per month, not per hook",
      matchManagers: ["pre-commit"],
      groupName: "pre-commit hooks",
      groupSlug: "pre-commit-hooks",
      schedule: ["before 6am on the first day of the month"],
      commitMessageTopic: "pre-commit hooks",
      commitMessageExtra: "({{groupName}})",
    },
    {
      description: "High-frequency upstreams — batch weekly to reduce noise",
      matchDepNames: ["ggml-org/llama.cpp", "leejet/stable-diffusion.cpp"],
      schedule: ["before 6am on Monday"],
      minimumReleaseAge: "2 days",
      groupName: "upstream-weekly",
      groupSlug: "upstream-weekly",
      branchPrefix: "renovate/upstream-",
      addLabels: ["upstream-rebuild"],
      commitMessageTopic: "upstream refs",
      commitMessageExtra: "({{groupName}})",
    },
    {
      description: "Low-frequency upstreams — update after release buffer",
      matchDepNames: ["ggml-org/ggml", "ggml-org/whisper.cpp", "mudler/parakeet.cpp"],
      schedule: ["at any time"],
      minimumReleaseAge: "2 days",
      branchPrefix: "renovate/upstream-",
      addLabels: ["upstream-rebuild"],
      commitMessageTopic: "upstream refs",
      commitMessageExtra: "({{groupName}})",
    },
  ],
}
