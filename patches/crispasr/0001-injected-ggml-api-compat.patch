diff --git a/src/core/ggml_crisp_compat.h b/src/core/ggml_crisp_compat.h
new file mode 100644
index 0000000..338c2b1
--- /dev/null
+++ b/src/core/ggml_crisp_compat.h
@@ -0,0 +1,46 @@
+// Compat shims for CrispASR ops absent from injected adyranov/ggml.
+#pragma once
+
+#include "ggml.h"
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+static inline struct ggml_tensor * ggml_norm_affine(
+        struct ggml_context * ctx,
+        struct ggml_tensor  * a,
+        struct ggml_tensor  * w,
+        struct ggml_tensor  * b,
+        float                 eps) {
+    return ggml_add(ctx, ggml_mul(ctx, ggml_norm(ctx, a, eps), w), b);
+}
+
+static inline struct ggml_tensor * ggml_crisp_view_gate_half(
+        struct ggml_context * ctx,
+        struct ggml_tensor  * a,
+        bool                  second_half) {
+    const int64_t n = a->ne[0] / 2;
+    const size_t  off = second_half ? (size_t) n * a->nb[0] : 0;
+    return ggml_view_2d(ctx, a, n, a->ne[1], a->nb[1], off);
+}
+
+static inline struct ggml_tensor * ggml_siglu(
+        struct ggml_context * ctx,
+        struct ggml_tensor  * a) {
+    struct ggml_tensor * gate = ggml_crisp_view_gate_half(ctx, a, false);
+    struct ggml_tensor * val  = ggml_crisp_view_gate_half(ctx, a, true);
+    return ggml_mul(ctx, ggml_sigmoid(ctx, gate), val);
+}
+
+static inline struct ggml_tensor * ggml_siglu_swapped(
+        struct ggml_context * ctx,
+        struct ggml_tensor  * a) {
+    struct ggml_tensor * gate = ggml_crisp_view_gate_half(ctx, a, false);
+    struct ggml_tensor * val  = ggml_crisp_view_gate_half(ctx, a, true);
+    return ggml_mul(ctx, gate, ggml_sigmoid(ctx, val));
+}
+
+#ifdef __cplusplus
+}
+#endif
