From 96000339e97564e4298845fee81cb1592b3921d4 Mon Sep 17 00:00:00 2001
From: Artem Dyranov <1038141+adyranov@users.noreply.github.com>
Date: Fri, 12 Jun 2026 17:44:52 -0400
Subject: [PATCH] fix: add missing K parameter to ggml_gated_delta_net calls

The ggml v0.15.0 API change adds int64_t K parameter to ggml_gated_delta_net().
Update both call sites in delta-net-base.cpp to pass the K parameter:
- First call: K=1 (final state only)
- Second call: K=cparams.n_rs_seq+1 (from context)
---
 examples/talk-llama/models/delta-net-base.cpp | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/examples/talk-llama/models/delta-net-base.cpp b/examples/talk-llama/models/delta-net-base.cpp
index 4f4c7cac..8c01d9c2 100644
--- a/examples/talk-llama/models/delta-net-base.cpp
+++ b/examples/talk-llama/models/delta-net-base.cpp
@@ -400,7 +400,7 @@ std::pair<ggml_tensor *, ggml_tensor *> llm_build_delta_net_base::build_delta_ne

     // K=1 (final state only): reshape to 3D (S_v*S_v*H_v, 1, n_seqs) for ggml_gated_delta_net.
     ggml_tensor * s_3d = ggml_reshape_3d(ctx0, s, S_v * S_v * H_v, 1, n_seqs);
-    ggml_tensor * result = ggml_gated_delta_net(ctx0, q, k, v, g, b, s_3d);
+    ggml_tensor * result = ggml_gated_delta_net(ctx0, q, k, v, g, b, s_3d, 1);
     if (n_tokens == 1) {
         cb(result, LLAMA_TENSOR_NAME_FGDN_AR, il);
     } else {
@@ -568,7 +568,7 @@ ggml_tensor * llm_build_delta_net_base::build_recurrent_attn(
     ggml_tensor * s_3d     = ggml_reshape_3d(ctx0, s, D, 1, n_seqs);
     ggml_tensor * s_3d_pad = ggml_pad       (ctx0, s_3d, 0, K - 1, 0, 0);

-    ggml_tensor * gdn_out = ggml_gated_delta_net(ctx0, q, k, v, g, b, s_3d_pad);
+    ggml_tensor * gdn_out = ggml_gated_delta_net(ctx0, q, k, v, g, b, s_3d_pad, K);
     if (n_seq_tokens > 1) {
         cb(gdn_out, LLAMA_TENSOR_NAME_FGDN_CH, il);
     } else {
--
