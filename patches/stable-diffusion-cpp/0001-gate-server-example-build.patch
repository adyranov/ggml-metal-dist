From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Artem Dyranov <1038141+adyranov@users.noreply.github.com>
Date: Tue, 16 Jun 2026 00:00:00 -0400
Subject: [PATCH] build: gate server example behind SD_BUILD_SERVER

Allow packagers to build and install the CLI example without also building the
HTTP server example.
---
 CMakeLists.txt          | 2 +-
 examples/CMakeLists.txt | 4 +++-
 2 files changed, 4 insertions(+), 2 deletions(-)

diff --git a/CMakeLists.txt b/CMakeLists.txt
index 0000000..0000000 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -94,6 +94,6 @@ option(SD_BUILD_SHARED_LIBS          "sd: build shared libs" OFF)
 option(SD_BUILD_SHARED_GGML_LIB      "sd: build ggml as a separate shared lib" OFF)
 option(SD_USE_SYSTEM_GGML            "sd: use system-installed GGML library" OFF)
-#option(SD_BUILD_SERVER               "sd: build server example"                           ON)
+option(SD_BUILD_SERVER               "sd: build server example" ${SD_STANDALONE})

 set(CMAKE_C_STANDARD 11)
 set(CMAKE_C_STANDARD_REQUIRED true)
diff --git a/examples/CMakeLists.txt b/examples/CMakeLists.txt
index 0000000..0000000 100644
--- a/examples/CMakeLists.txt
+++ b/examples/CMakeLists.txt
@@ -4 +4,3 @@ add_subdirectory(cli)
-add_subdirectory(server)
\ No newline at end of file
+if(SD_BUILD_SERVER)
+    add_subdirectory(server)
+endif()
--
2.54.0
